---
interface Props {
  name: string;
  mark: string;
  categoryEn: string;
  categoryEs: string;
  descriptionEn: string;
  descriptionEs: string;
  technologies: string[];
  liveUrl: string;
  repoUrl: string;
  privateAccess?: boolean;
  privateRepo?: boolean;
  accent: string;
}

const {
  name,
  mark,
  categoryEn,
  categoryEs,
  descriptionEn,
  descriptionEs,
  technologies,
  liveUrl,
  repoUrl,
  privateAccess = false,
  privateRepo = false,
  accent,
} = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm transition-shadow hover:shadow-lg">
  <div class={`flex h-28 items-center justify-between px-6 ${accent}`}>
    <span class="text-4xl font-black tracking-tight opacity-90" aria-hidden="true">{mark}</span>
    <span class="rounded-full border border-current/30 px-3 py-1 text-xs font-semibold uppercase tracking-wider" data-text-en={categoryEn} data-text-es={categoryEs}>{categoryEn}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-2xl font-bold">{name}</h3>
      {privateAccess && <span class="badge badge-outline text-xs" data-i18n="privateAccess">Private access</span>}
    </div>
    <p class="mt-3 flex-1 leading-relaxed opacity-80" data-text-en={descriptionEn} data-text-es={descriptionEs}>{descriptionEn}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((technology) => <span class="badge badge-ghost badge-sm">{technology}</span>)}
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary btn-sm" href={liveUrl} target="_blank" rel="noopener noreferrer" data-i18n="openProject">Open app</a>
      <a class="btn btn-outline btn-sm" href={repoUrl} target="_blank" rel="noopener noreferrer" data-i18n={privateRepo ? "privateRepository" : "viewRepository"}>{privateRepo ? "Private repository" : "GitHub repository"}</a>
    </div>
  </div>
</article>
