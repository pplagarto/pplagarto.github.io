---
import LogoProposal from "./LogoProposal.astro";

interface Props {
  slug: string;
  name: string;
  logo: "guitar" | "casa" | "recetary" | "algrano";
  categoryEn: string;
  categoryEs: string;
  descriptionEn: string;
  descriptionEs: string;
  technologies: readonly string[];
  preview: string;
  previewLabelEn: string;
  previewLabelEs: string;
  liveUrl: string;
  repoUrl: string;
  privateAccess?: boolean;
  privateRepo?: boolean;
}

const {
  slug,
  name,
  logo,
  categoryEn,
  categoryEs,
  descriptionEn,
  descriptionEs,
  technologies,
  preview,
  previewLabelEn,
  previewLabelEs,
  liveUrl,
  repoUrl,
  privateAccess = false,
  privateRepo = false,
} = Astro.props;
---

<article id={slug} class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">
  <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="group relative block overflow-hidden bg-base-200">
    <img src={preview} alt={name} loading="lazy" class="aspect-[16/8] w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]" />
    <span class="absolute bottom-3 left-3 rounded-full bg-neutral px-3 py-1.5 text-xs font-semibold text-neutral-content shadow-md" data-text-en={previewLabelEn} data-text-es={previewLabelEs}>{previewLabelEn}</span>
  </a>
  <div class="grid gap-7 p-6 md:grid-cols-[minmax(0,1fr)_auto] md:p-8">
    <div class="min-w-0">
      <div class="text-xs font-bold uppercase tracking-[0.18em] opacity-60" data-text-en={categoryEn} data-text-es={categoryEs}>{categoryEn}</div>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <h2 class="text-3xl font-bold">{name}</h2>
        {privateAccess && <span class="badge badge-outline text-xs" data-i18n="privateAccess">Private access</span>}
      </div>
      <p class="mt-3 max-w-prose leading-relaxed opacity-80" data-text-en={descriptionEn} data-text-es={descriptionEs}>{descriptionEn}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {technologies.map((technology) => <span class="badge badge-ghost badge-sm">{technology}</span>)}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary btn-sm" href={liveUrl} target="_blank" rel="noopener noreferrer" data-i18n="openProject">Open app</a>
        <a class="btn btn-outline btn-sm" href={repoUrl} target="_blank" rel="noopener noreferrer" data-i18n={privateRepo ? "privateRepository" : "viewRepository"}>{privateRepo ? "Private repository" : "GitHub repository"}</a>
      </div>
    </div>
    <div class="border-t border-base-300 pt-5 md:w-52 md:border-l md:border-t-0 md:pl-6 md:pt-0">
      <div class="text-xs font-bold uppercase tracking-[0.14em] opacity-60" data-i18n="logoConcepts">Logo concepts</div>
      <div class="mt-4 flex gap-4 md:flex-col">
        <div class="flex items-center gap-2">
          <LogoProposal project={logo} option="a" />
          <span class="text-xs opacity-60">A</span>
        </div>
        <div class="flex items-center gap-2">
          <LogoProposal project={logo} option="b" />
          <span class="text-xs opacity-60">B</span>
        </div>
      </div>
    </div>
  </div>
</article>
