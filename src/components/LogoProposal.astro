---
interface Props {
  project: "guitar" | "casa" | "recetary" | "algrano";
  option: "a" | "b";
}

const { project, option } = Astro.props;
const colors = {
  guitar: { background: "#191c19", foreground: "#e6b876", detail: "#b9ce91" },
  casa: { background: "#244b42", foreground: "#f4efdf", detail: "#d5ad73" },
  recetary: { background: "#b73d24", foreground: "#fff5e3", detail: "#e9bc69" },
  algrano: { background: "#2d5140", foreground: "#f7f4e9", detail: "#d6ba77" },
}[project];
---

<svg viewBox="0 0 96 96" class="h-20 w-20 rounded-2xl shadow-sm" aria-hidden="true">
  <rect width="96" height="96" rx="20" fill={colors.background} />
  {project === "guitar" && option === "a" && <>
    <circle cx="48" cy="51" r="29" fill={colors.foreground} />
    <circle cx="48" cy="51" r="11" fill={colors.background} />
    <path d="M38 14v68M42 14v68M46 14v68M50 14v68M54 14v68M58 14v68" stroke={colors.detail} stroke-width="1.5" />
  </>}
  {project === "guitar" && option === "b" && <>
    <path d="M48 15c17 0 31 13 31 31 0 20-16 31-31 37C33 77 17 66 17 46c0-18 14-31 31-31Z" fill="none" stroke={colors.foreground} stroke-width="5" />
    <path d="M35 30v36M41 30v36M47 30v36M53 30v36M59 30v36M65 30v36" stroke={colors.detail} stroke-width="2" />
    <circle cx="50" cy="50" r="10" fill={colors.background} stroke={colors.foreground} stroke-width="3" />
  </>}
  {project === "casa" && option === "a" && <>
    <path d="M19 43 48 19l29 24v34H57V53H39v24H19Z" fill="none" stroke={colors.foreground} stroke-linecap="round" stroke-linejoin="round" stroke-width="5" />
    <circle cx="69" cy="25" r="6" fill={colors.detail} />
  </>}
  {project === "casa" && option === "b" && <>
    <path d="M17 47 48 20l31 27" fill="none" stroke={colors.foreground} stroke-linecap="round" stroke-linejoin="round" stroke-width="6" />
    <path d="M25 44v31h46V44" fill="none" stroke={colors.foreground} stroke-linecap="round" stroke-linejoin="round" stroke-width="5" />
    <path d="m38 59 8 8 15-17" fill="none" stroke={colors.detail} stroke-linecap="round" stroke-linejoin="round" stroke-width="6" />
  </>}
  {project === "recetary" && option === "a" && <>
    <path d="M20 25c11-4 20-3 28 3 8-6 17-7 28-3v47c-11-3-20-2-28 4-8-6-17-7-28-4Z" fill="none" stroke={colors.foreground} stroke-linejoin="round" stroke-width="4" />
    <path d="M48 29v46M30 39h9M30 49h9M57 39h9M57 49h9" stroke={colors.detail} stroke-linecap="round" stroke-width="3" />
  </>}
  {project === "recetary" && option === "b" && <>
    <path d="M20 51h56c-2 17-13 26-28 26S22 68 20 51Z" fill={colors.foreground} />
    <path d="M29 83h38M37 35c-5-6-3-11 2-16M49 35c-5-6-3-11 2-16M61 35c-5-6-3-11 2-16" fill="none" stroke={colors.detail} stroke-linecap="round" stroke-width="4" />
  </>}
  {project === "algrano" && option === "a" && <>
    <path d="M48 76V26M48 61 31 49m17 1L31 38m17 1L35 27m13 34 17-12M48 50l17-12M48 39l13-12" fill="none" stroke={colors.foreground} stroke-linecap="round" stroke-width="4" />
    <path d="M28 48c-7-8-8-15-7-19 8 0 14 4 18 12M68 40c4-8 10-11 17-11 0 7-3 14-9 19" fill={colors.detail} />
    <path d="M32 78h32" stroke={colors.detail} stroke-linecap="round" stroke-width="4" />
  </>}
  {project === "algrano" && option === "b" && <>
    <rect x="22" y="18" width="52" height="60" rx="8" fill="none" stroke={colors.foreground} stroke-width="4" />
    <path d="M32 33h32M32 44h20M32 57h11M54 57h11M32 68h11M54 68h11" stroke={colors.detail} stroke-linecap="round" stroke-width="4" />
  </>}
</svg>
