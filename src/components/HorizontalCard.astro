---
const { title, titleEs, img, desc, descEs, url, badge, period, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
const tagLabelsEs = {
  "Home Automation": "Automatización Residencial",
  "Field Engineering": "Ingeniería de Campo",
  "Maintenance": "Mantenimiento",
  "Metal Detection": "Detección de Metales",
  "Security Equipment": "Equipos de Seguridad",
  "Networking": "Redes",
  "Troubleshooting": "Diagnóstico",
  "Windows and Linux": "Windows y Linux",
  "Service": "Servicio",
};
---

<div
class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%] " 
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg "
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          <span data-text-en={title} data-text-es={titleEs || title}>{title}</span>
          {badge && <div class="badge badge-secondary mx-2" data-i18n={badge === "Current" ? "current" : undefined}>{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">
          <span data-text-en={desc} data-text-es={descEs || desc}>{desc}</span>
        </p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  <span data-text-en={tag} data-text-es={tagLabelsEs[tag] || tag}>{tag}</span>
                </a>
              ))
          }
        </div>
      </div>
      <div class="border-primary grow w-full flex text-primary italic tracking-wide font-semibold text-xl">
          {period}
      </div>
    </div>
  </a>
</div>
