---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">
    <div class="relative mb-4">
      <a href="/" class="block">
        <div class="relative overflow-hidden">
          <Image
            class="h-[18rem] w-full object-cover object-top grayscale"
            format="webp"
            width={420}
            height={520}
            src="/fotoJGLG.jpeg"
            alt="Profile image"
          />
          <div class="pointer-events-none absolute -left-20 top-10 h-16 w-[150%] -rotate-[30deg] bg-gradient-to-r from-primary/45 via-base-100/20 to-transparent mix-blend-overlay"></div>
          <div class="pointer-events-none absolute -right-16 bottom-12 h-10 w-[110%] -rotate-[30deg] bg-neutral/20 mix-blend-multiply"></div>
        </div>
      </a>
      <div class="-mt-8 mx-5 overflow-hidden rounded-lg bg-neutral p-5 text-neutral-content shadow-2xl ring-1 ring-neutral-content/10 relative">
        <div class="relative z-10">
          <div class="text-4xl font-black leading-none">Gerardo Lagunes</div>
          <div
            class="mt-2 text-base opacity-90"
            data-text-en="Cloud Support Engineer"
            data-text-es="Cloud Support Engineer"
          >
            Cloud Support Engineer
          </div>
          <div class="mt-4 h-[2px] w-16 bg-neutral-content"></div>
          <div class="mt-4 text-sm leading-6">
            <div class="font-bold" data-text-en="Contact" data-text-es="Contacto">Contact</div>
            <a href="mailto:pepe.lag.gar@gmail.com" class="opacity-90 hover:opacity-100">pepe.lag.gar@gmail.com</a>
          </div>
        </div>
      </div>
    </div>
    <div class="px-2 flex grow shrink flex-col">
      <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    </div>
    <SideBarFooter />
  </aside>
</div>
