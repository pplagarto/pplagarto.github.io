    <li>
      <a href="/KardexCursoLaboral.jpeg" target="_blank">Kardex Liderazgo Laboral
        <img src="/KardexCursoLaboral.jpeg" alt="" class="flex justify-center size-60">
      </a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Software</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>C++</li>
    <li>AutoDesk</li>
    <li>Office 365</li>
    <li>LabView</li>
    <li>Matlab</li>
    <li>TIA Portal</li>
