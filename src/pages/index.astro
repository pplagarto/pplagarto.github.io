---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => {
  if (a.data.badge === "Current" && b.data.badge !== "Current") return -1;
  if (b.data.badge === "Current" && a.data.badge !== "Current") return 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const last_posts = posts.slice(0, );

const projects = [
  {
    name: "GuitarApp",
    mark: "GA",
    categoryEn: "Music · PWA",
    categoryEs: "Música · PWA",
    descriptionEn: "A guitar companion for saving and reviewing tablature and chord sheets, with a microphone tuner, alternate tunings, favorites, and offline access.",
    descriptionEs: "Una app para guardar y revisar tablaturas y letras con acordes, con afinador por micrófono, afinaciones alternativas, favoritos y acceso sin conexión.",
    technologies: ["JavaScript", "Web Audio", "PWA"],
    liveUrl: "https://seis-cuerdas.pepe-lag-gar-3da.workers.dev/",
    repoUrl: "https://github.com/pplagarto/guitarpepe",
    accent: "bg-primary text-primary-content",
  },
  {
    name: "CasaClara",
    mark: "CC",
    categoryEn: "Shared finances",
    categoryEs: "Finanzas compartidas",
    descriptionEn: "A private app for tracking shared household expenses, reimbursements, receipts, and balances with individual accounts and a complete history.",
    descriptionEs: "Una app privada para registrar gastos del hogar, reembolsos, comprobantes y saldos, con cuentas individuales e historial completo.",
    technologies: ["JavaScript", "Cloudflare Workers", "D1"],
    liveUrl: "https://casa-clara-jose-daniela.pepe-lag-gar-3da.workers.dev/",
    repoUrl: "https://github.com/pplagarto/casaclara",
    privateAccess: true,
    accent: "bg-secondary text-secondary-content",
  },
  {
    name: "Recetary",
    mark: "RE",
    categoryEn: "Food · Planning",
    categoryEs: "Cocina · Planeación",
    descriptionEn: "A recipe collection with ingredient search, adjustable quantities, and a shopping list that combines ingredients across selected recipes.",
    descriptionEs: "Un recetario con búsqueda por ingrediente, cantidades ajustables y una lista de compras que reúne ingredientes de varias recetas.",
    technologies: ["JavaScript", "LocalStorage", "Cloudflare Workers"],
    liveUrl: "https://recetario-de-pepe.pepe-lag-gar-3da.workers.dev/",
    repoUrl: "https://github.com/pplagarto/recetario",
    accent: "bg-accent text-accent-content",
  },
  {
    name: "Al Grano ERP",
    mark: "AG",
    categoryEn: "Retail · ERP",
    categoryEs: "Comercio · ERP",
    descriptionEn: "An inventory and point-of-sale system for a retail shop, covering product lots, purchases, cash register shifts, returns, and operational reports.",
    descriptionEs: "Un sistema de inventario y punto de venta para una tienda, con lotes, compras, turnos de caja, devoluciones y reportes operativos.",
    technologies: ["Cloudflare Workers", "Supabase", "PostgreSQL"],
    liveUrl: "https://algrano-erp.pepe-lag-gar-3da.workers.dev/",
    repoUrl: "https://github.com/pplagarto/algrano-ERP",
    privateAccess: true,
    privateRepo: true,
    accent: "bg-neutral text-neutral-content",
  },
];
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5 ">
    <div class="text-xl py-1" data-i18n="intro">Hi, I'm Gerardo</div>
    <div class="text-5xl font-bold">I'm Jose Gerardo Lagunes Garcia</div>
    <div class="text-3xl py-3 font-bold" data-i18n="role">Cloud Support Engineer | Control and Automation Engineer</div>
    <div class="py-2">
      <p class="text-lg" data-i18n="summary">
        I am a Control and Automation Engineer currently focused on cloud infrastructure, networking, and technical support for enterprise environments.
        My work combines structured troubleshooting, customer communication, and continuous learning across cloud services, databases, Linux, and networking.
      </p>
    </div>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-base-300 bg-base-200 px-4 py-3 text-center">
        <div class="text-sm uppercase tracking-wide opacity-70" data-i18n="currentFocus">Current Focus</div>
        <div class="text-lg font-bold">OCI Networking</div>
      </div>
      <div class="rounded-lg border border-base-300 bg-base-200 px-4 py-3 text-center">
        <div class="text-sm uppercase tracking-wide opacity-70" data-i18n="strength">Strength</div>
        <div class="text-lg font-bold" data-i18n="troubleshooting">Troubleshooting</div>
      </div>
      <div class="rounded-lg border border-base-300 bg-base-200 px-4 py-3 text-center">
        <div class="text-sm uppercase tracking-wide opacity-70" data-i18n="background">Background</div>
        <div class="text-lg font-bold" data-i18n="automation">Automation</div>
      </div>
    </div>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a class="btn btn-primary btn-lg min-w-[14rem] shadow-lg shadow-primary/20" href="/CV_JGLG_JULIO_2024_ENG3.pdf" download="CV_JGLG_JULIO_2024_ENG3.pdf">
        <span data-i18n="downloadResume">Download Resume</span>
      </a>
      <a class="btn btn-outline btn-lg min-w-[14rem]" href="/cv" id="cv">
        <span data-i18n="viewTimeline">View Timeline</span>
      </a>
      <a class="btn btn-ghost btn-lg min-w-[14rem]" href="https://www.linkedin.com/in/gerardolagunes/" target="_blank">
        LinkedIn
      </a>
    </div>  
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10" data-i18n="professionalExperience">Professional Experience</div>
  </div>

   
  {
    last_posts.map((post) => (
      <>
          <HorizontalCard
          title={post.data.displayTitle || post.data.title}
          titleEs={post.data.displayTitleEs}
          img={post.data.heroImage}
          desc={post.data.description}
          descEs={post.data.descriptionEs}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <section id="projects" class="scroll-mt-20 pt-10" aria-labelledby="projects-heading">
    <div class="mb-6">
      <h2 id="projects-heading" class="text-3xl font-bold" data-i18n="projects">Projects</h2>
      <p class="mt-2 opacity-75" data-i18n="projectsIntro">Apps I've built to solve practical problems, from everyday tools to business operations.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
