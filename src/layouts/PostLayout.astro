---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import "dayjs/locale/es";

export interface Props extends BlogSchema {}

const { title, displayTitle, displayTitleEs, description, descriptionEs, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
const displayDateEs = dayjs(pubDate).locale("es").format("ll")
const tagLabelsEs = {
  "Home Automation": "Automatización Residencial",
  "Field Engineering": "Ingeniería de Campo",
  "Maintenance": "Mantenimiento",
  "Metal Detection": "Detección de Metales",
  "Security Equipment": "Equipos de Seguridad",
  "Networking": "Redes",
  "Troubleshooting": "Diagnóstico",
  "Windows and Linux": "Windows y Linux",
  "Service": "Servicio",
};
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article">
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold" data-text-en={displayTitle || title} data-text-es={displayTitleEs || displayTitle || title}>{displayTitle || title}</h1>
      {pubDate && <time data-text-en={displayDate} data-text-es={displayDateEs}>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1" data-i18n={badge === "Current" ? "current" : undefined}>{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              <span data-text-en={tag} data-text-es={tagLabelsEs[tag] || tag}>{tag}</span>
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            <span data-text-en="Last updated on" data-text-es="Actualizado el">Last updated on</span> <time>{updatedDate}</time>
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>
  </main>
</BaseLayout>
